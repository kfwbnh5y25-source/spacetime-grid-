        bk = base_k + "__BL"
        b = f[bk]["trace"][:, 1, :].mean(0).astype(np.float64) if bk in f else np.zeros_like(s)
        keys.append(base_k); specs.append(s - b)

band = (fr >= 2030.0) & (fr <= 2075.0)
