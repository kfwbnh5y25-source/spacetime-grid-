from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import confusion_matrix
from numpy.lib.stride_tricks import sliding_window_view

def hampel(specs, hw=7, nsig=5.0):
    pad = np.pad(specs, ((0,0),(hw,hw)), mode="edge")
    win = sliding_window_view(pad, 2*hw+1, axis=1)
    med = np.median(win, axis=2)
    mad = np.median(np.abs(win - med[:,:,None]), axis=2)
    sig = 1.4826 * mad
    mask = (sig > 0) & (np.abs(specs - med) > nsig*sig)
    out = specs.copy()
    out[mask] = med[mask]
    return out

def eval_cv(X, y, n_splits=5, seed=42):
    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=seed)
    preds = np.zeros(len(y), dtype=int)
    for tr, te in skf.split(X, y):
        sc = StandardScaler().fit(X[tr])
        clf = RidgeClassifier(alpha=1.0).fit(sc.transform(X[tr]), y[tr])
        preds[te] = clf.predict(sc.transform(X[te]))
    acc = float(np.mean(preds == y))
    cm = confusion_matrix(y, preds)
    return acc, cm

