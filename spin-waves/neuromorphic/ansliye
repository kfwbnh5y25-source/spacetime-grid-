        X_eq_ctrl.append(v)
        y_ctrl.append(s[1])

acc_lag1, cm_lag1 = eval_cv(np.array(X_eq), np.array(y_lag1))
acc_lag0, _ = eval_cv(np.array(X_eq), np.array(y_lag0))
acc_lag2, _ = eval_cv(np.array(X_eq), np.array(y_lag2))
acc_eq_ctrl, _ = eval_cv(np.array(X_eq_ctrl), np.array(y_ctrl))

